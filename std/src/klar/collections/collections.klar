public type SortOrder {
    .increasing = 2, // A < B
    .equal = 0, // A == B
    .decreasing = 1 // A > B
}

public func (a: SortOrder).greater(than b: SortOrder) -> Bool = a.value > b.value
public func (a: SortOrder).greaterOrEqual(to b: SortOrder) -> Bool = a.value >= b.value
public func (a: SortOrder).less(than b: SortOrder) -> Bool = a.value < b.value
public func (a: SortOrder).lessOrEqual(to b: SortOrder) -> Bool = a.value <= b.value

public func (a: SortOrder).compare(to b: SortOrder) -> SortOrder = when a.value {
    < b.value -> .increasing,
    == b.value -> .equal,
    > b.value -> .decreasing,
    _ -> crashout("Unreachable"),
}
