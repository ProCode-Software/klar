{
    "name": "klar",
    "displayName": "Klar",
    "version": "0.0.1",
    "description": "The progressive programming language",
    "categories": [
        "Programming Languages"
    ],
    "license": "Apache-2.0",
    "author": {
        "name": "ProCode Software"
    },
    "publisher": "klar",
    "type": "module",
    "main": "dist/index.js",
    "scripts": {
        "watch": "vsxtools run --watch",
        "build": "vsxtools run && bun run build-server && vsxtools pack",
        "build-server": "esbuild src/extension/index.ts --bundle --outdir=dist --platform=node --external:vscode --format=cjs",
        "ext-install": "bun run build && code --install-extension ./klar-*.vsix"
    },
    "dependencies": {
        "vscode-languageclient": "^10.1.0"
    },
    "devDependencies": {
        "@types/node": "^26.2.0",
        "@types/vscode": "1.99.0",
        "@vscode/vsce": "^3.9.2",
        "esbuild": "^0.28.2",
        "vsxtools": "latest"
    },
    "contributes": {
        "languages": [
            {
                "firstLine": "^#!\\/usr\\/bin\\env\\s+klar",
                "id": "klar",
                "aliases": [
                    "Klar",
                    "klar"
                ],
                "extensions": [
                    ".klar"
                ],
                "configuration": "./language-configuration.json"
            },
            {
                "id": "klon",
                "aliases": [
                    "Klon",
                    "klon"
                ],
                "extensions": [
                    ".klon",
                    "glas.pack",
                    "klar.build"
                ],
                "configuration": "./klon.language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "klar",
                "scopeName": "source.klar",
                "path": "./syntaxes/klar.tmLanguage.json"
            },
            {
                "language": "klon",
                "scopeName": "source.klon",
                "path": "./syntaxes/klon.tmLanguage.json"
            },
            {
                "scopeName": "markdown.klar.codeblock",
                "path": "./syntaxes/codeblock.tmLanguage.json",
                "injectTo": [
                    "text.html.markdown"
                ],
                "embeddedLanguages": {
                    "meta.embedded.block.klar": "klar",
                    "meta.embedded.block.klon": "klon"
                }
            }
        ],
        "commands": [
            {
                "command": "klar.restartServer",
                "title": "Restart Language Server",
                "category": "Klar"
            }
        ],
        "configuration": {
            "title": "Klar",
            "properties": {
                "klar.path": {
                    "type": [
                        "string"
                    ],
                    "default": null,
                    "description": "Path to 'klar' executable. If empty, the extension will look for 'klar' in PATH. Relative paths are relative to the workspace root."
                }
            }
        }
    },
    "engines": {
        "vscode": "^1.99.0"
    }
}
