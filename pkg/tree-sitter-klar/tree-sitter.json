{
    "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
    "grammars": [
        {
            "name": "klar",
            "camelcase": "Klar",
            "title": "Klar",
            "scope": "source.klar",
            "file-types": ["klar"],
            "injection-regex": "^klar$",
            "class-name": "TreeSitterKlar"
        }
    ],
    "metadata": {
        "version": "0.1.0",
        "license": "Apache-2.0",
        "description": "The progressive programming language",
        "authors": [
            {
                "name": "ProCode Software"
            }
        ],
        "links": {
            "repository": "https://github.com/ProCode-Software/klar"
        }
    },
    "bindings": {
        "c": false,
        "go": false,
        "java": false,
        "node": true,
        "python": false,
        "rust": false,
        "swift": false,
        "zig": false
    }
}
