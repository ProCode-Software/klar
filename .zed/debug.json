// Project-local debug tasks
//
// For more documentation on how to configure debug tasks,
// see: https://zed.dev/docs/debugger
[
    {
        "label": "Run Klar",
        "adapter": "Delve",
        "console": "internalConsole",
        "program": "${ZED_WORKTREE_ROOT}/cmd/klar",
        "request": "launch",
        "showGlobalVariables": true,
        "args": ["build", "./samples/mylang"],
        "env": { "GOEXPERIMENT": "jsonv2", "KLAR_STD": "${ZED_WORKTREE_ROOT}/std" },
        "buildFlags": ["--ldflags", "-X 'github.com/ProCode-Software/klar/internal/cli.KlarVersion=0.0.1'"],
        "mode": "debug",
    },
]
