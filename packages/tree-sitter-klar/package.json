{
    "name": "tree-sitter-klar",
    "version": "0.1.0",
    "description": "The progressive programming language",
    "keywords": [
        "incremental",
        "klar",
        "parsing",
        "tree-sitter"
    ],
    "license": "Apache-2.0",
    "author": {
        "name": "ProCode Software"
    },
    "repository": {
        "type": "git",
        "url": "git+github.com/ProCode-Software/klar.git"
    },
    "files": [
        "grammar.js",
        "tree-sitter.json",
        "binding.gyp",
        "prebuilds/**",
        "bindings/node/*",
        "queries/*",
        "src/**",
        "*.wasm"
    ],
    "type": "module",
    "main": "bindings/node",
    "types": "bindings/node",
    "scripts": {
        "generate": "tree-sitter generate && rm ./.editorconfig",
        "prestart": "tree-sitter build --wasm",
        "build": "tree-sitter build --wasm",
        "start": "tree-sitter playground",
        "test": "bun test bindings/node/*_test.js"
    },
    "dependencies": {
        "node-addon-api": "^8.5.0",
        "node-gyp-build": "^4.8.4"
    },
    "devDependencies": {
        "prebuildify": "^6.0.1",
        "tree-sitter": "^0.25.1",
        "tree-sitter-cli": "^0.26.11"
    },
    "peerDependencies": {
        "tree-sitter": "^0.25.1"
    },
    "peerDependenciesMeta": {
        "tree-sitter": {
            "optional": true
        }
    }
}
