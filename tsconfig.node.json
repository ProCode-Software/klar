{
    "extends": ["./tsconfig.json"],
    "compilerOptions": {
        "module": "nodenext",
        "moduleDetection": "force",
        "jsx": "react-jsx",
        "allowJs": true,
        "checkJs": true,
        "types": ["bun"],
        "lib": ["ESNext"],
        // TODO: Change this to ES2026 once TypeScript 7.1 is released
        "target": "es2025",
        "allowImportingTsExtensions": true,
    },
    "include": ["./scripts"],
}
